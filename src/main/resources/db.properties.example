# ============================================================
# 数据库连接配置模板（db.properties.example）
# ------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为同目录下的 db.properties
#        Linux / macOS:  cp src/main/resources/db.properties.example src/main/resources/db.properties
#        Windows:        copy src\main\resources\db.properties.example src\main\resources\db.properties
#   2. 把 db.username / db.password 改成你本机 MySQL 的真实账号密码
#
# 说明：db.properties 已被 .gitignore 忽略，属于「本地私有配置」，
#       不会被提交到 Git 仓库，因此可以放心写入真实密码。
# ============================================================

# 数据库驱动类 (MySQL 8.0+ 推荐使用 com.mysql.cj.jdbc.Driver)
db.driver=com.mysql.cj.jdbc.Driver

# 连接地址与端口:
# 127.0.0.1:3306 为本地地址与端口
# student_db 为 schema.sql 中创建的数据库名称
# 常用参数说明:
# - useSSL=false: 本地开发通常关闭 SSL 警告
# - serverTimezone=Asia/Shanghai: 避免 MySQL 8.x 常见的时区报错
# - characterEncoding=UTF-8: 完整支持 UTF-8 字符（包含 Emoji）
# - allowPublicKeyRetrieval=true: 允许检索公钥（解决部分客户端 sha2 认证连接报错）
db.url=jdbc:mysql://127.0.0.1:3306/student_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&allowPublicKeyRetrieval=true

# 本地 MySQL 登录用户名 (默认为 root)
db.username=root

# 本地 MySQL 登录密码 (替换为您自己的密码)
db.password=your_password
